# Copy to .env.local for development. In production set these as Railway variables.

# PostgreSQL (Railway's Postgres service provides this as ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://flownote:flownote@localhost:5544/flownote

# Public address the app is served from
PUBLIC_URL=http://localhost:3100
COOKIE_SECURE=false
NEXT_PUBLIC_BASE_PATH=

# S3-compatible object store for shared files and synced guides (a Railway bucket in production)
S3_ENDPOINT_URL=http://127.0.0.1:3920
S3_REGION=auto
S3_BUCKET=flownote-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# false for virtual-hosted buckets such as Railway's
S3_FORCE_PATH_STYLE=true

# The OpenAI key every account uses for FlowNote AI. Never sent to clients.
OPENAI_API_KEY=
# Optional comma-separated list of models the shared key may be used for.
OPENAI_ALLOWED_MODELS=
# AI requests each account may make per day on the shared key (default 100).
AI_DAILY_LIMIT=100
# Encrypts users' personal API keys at rest (base64, 32 bytes): openssl rand -base64 32
SECRETS_KEY=

# Contact address shown on /privacy and /terms
SUPPORT_EMAIL=

# Email (Resend) for password resets. Without these, development prints emails to the console.
RESEND_API_KEY=
MAIL_FROM=

# Google sign-in. Redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extension IDs allowed to receive Google sign-in tokens (required in production)
EXTENSION_IDS=

# Stripe. Leave empty to turn payments and the free-recording limit off.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FREE_RECORDING_LIMIT=5
